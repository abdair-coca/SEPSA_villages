          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/debtors": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/query"
          },
          {
            "$ref": "#/components/parameters/area"
          },
          {
            "$ref": "#/components/parameters/locality"
          },
          {
            "$ref": "#/components/parameters/route"
          },
          {
