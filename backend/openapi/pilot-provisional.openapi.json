                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/sync/operations/{operation_id}/review": {
      "post": {
        "tags": [
          "Sync"
        ],
        "summary": "Registrar revisión humana sin confirmar resultado físico",
        "description": "Solo ADMIN. Requiere identidad exacta, expected_version y motivo. Cuando el lookup remoto no confirma la operación (por ejemplo, not_found), cambia el estado físico a PHYSICAL_UNKNOWN, conserva el estado de negocio de la orden, incrementa la versión de expected_version a expected_version + 1 y añade HUMAN_REVIEW_RECORDED. Nunca confirma ni habilita reenvío.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/operation_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HumanReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Revisión registrada; corte sigue incierto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanReviewResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque pilot token"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sepsa_session"
      }
    },
    "parameters": {
      "query": {
        "name": "query",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "area": {
        "name": "area",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "locality": {
        "name": "locality",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "route": {
        "name": "route",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "order_id": {
        "name": "order_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "operation_id": {
        "name": "operation_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Error HTTP del backend",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Source": {
        "const": "PILOT_PROVISIONAL"
      },
      "Role": {
        "enum": [
          "ADMIN",
          "TECHNICIAN"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "source"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "session_id",
          "expires_at",
          "user",
          "source"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "user": {
            "type": "object",
            "required": [
              "user_id",
              "username",
              "display_name",
              "role"
            ],
            "properties": {
              "user_id": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "role": {
                "$ref": "#/components/schemas/Role"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "Technician": {
        "type": "object",
        "required": [
          "user_id",
          "username",
          "display_name",
          "role",
          "enabled",
          "source"
        ],
        "properties": {
          "user_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "const": "TECHNICIAN"
          },
          "enabled": {
            "const": true
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "additionalProperties": true
      },
      "TechniciansResponse": {
        "type": "object",
        "required": [
          "source",
          "technicians"
        ],
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "technicians": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Technician"
            }
          }
        },
        "additionalProperties": false
      },
      "Debtor": {
        "type": "object",
        "required": [
          "debtor_id",
          "account_id",
          "supply_id",
          "customer_name",
          "address",
          "references",
          "meter_id",
          "area",
          "locality",
          "route",
          "debt_cents",
          "months_pending",
          "updated_at",
          "kardex",
          "source"
        ],
        "properties": {
          "debtor_id": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "supply_id": {
            "type": "string"
          },
          "customer_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "references": {
            "type": [
              "string",
              "null"
            ]
          },
          "meter_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "area": {
            "type": [
              "string",
              "null"
            ]
          },
          "area_name": {
            "type": "string"
          },
          "locality": {
            "type": [
              "string",
              "null"
            ]
          },
          "route": {
            "type": [
              "string",
              "null"
            ]
          },
          "route_name": {
            "type": "string"
          },
          "debt_cents": {
            "type": "integer",
            "minimum": 0
          },
          "months_pending": {
            "type": "integer",
            "minimum": 0
          },
          "updated_at": {
            "type": "string"
          },
          "kardex": {
            "type": "array"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "additionalProperties": true
      },
      "DebtorsResponse": {
