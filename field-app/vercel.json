{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://sepsa-pilot-api.onrender.com/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/v1/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    }
  ]
}
